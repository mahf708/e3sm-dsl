
@article{leung_introduction_2020,
	title = {An {Introduction} to the {E3SM} {Special} {Collection}: {Goals}, {Science} {Drivers}, {Development}, and {Analysis}},
	volume = {12},
	issn = {1942-2466, 1942-2466},
	shorttitle = {An {Introduction} to the {E3SM} {Special} {Collection}},
	url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2019MS001821},
	doi = {10.1029/2019MS001821},
	abstract = {Abstract
            Supported by the U.S. Department of Energy (DOE), the Energy Exascale Earth System Model (E3SM) project aims to optimize the use of DOE resources to address the grand challenge of actionable predictions of Earth system variability and change. This requires sustained advancement to (1) integrate model development with leading‐edge computational advances toward ultra‐high‐resolution modeling; (2) represent the coupled human‐Earth system to address energy sector vulnerability to variability and change; and (3) address uncertainty in model simulations and projections. Scientific development of the E3SM modeling system is driven by the simulation requirements in three overarching science areas centering on understanding the Earth's water cycle, biogeochemistry, and cryosphere systems and their future changes. This paper serves as an introduction to the E3SM special collection, which includes 50 papers published in several AGU journals. It provides an overview of the E3SM project, including its goals and science drivers. It also provides a brief history of the development of E3SM version 1 and highlights some key findings from papers included in the special collection.
          , 
            Plain Language Summary
            Earth system models are important tools for predicting future changes in the Earth system. Supported by the U.S. Department of Energy (DOE), the Energy Exascale Earth System Model (E3SM) project aims to improve predictions of Earth system variability and change. The latter has a particular focus on predicting changes in the water cycle that influences precipitation and storms, biogeochemistry that influences greenhouse gases and future warming, and cryosphere systems that influence sea‐level rise that threatens coastal communities. This paper serves as an introduction to the E3SM special collection, which includes 50 papers published in several AGU journals. It provides an overview of the E3SM project, including its goals and science drivers. It also provides a brief history of the development of E3SM version 1 and highlights some key findings from papers included in the special collection.
          , 
            Key Points
            
              
                
                  The Energy Exascale Earth System Model (E3SM) project aims to improve actionable predictions of Earth system variability and change
                
                
                  Water cycle, biogeochemistry, and cryosphere systems are the three key science drivers of model development and numerical experiments
                
                
                  This paper provides an overview of the E3SM project and introduces the E3SM special collection of papers published in AGU journals},
	language = {en},
	number = {11},
	urldate = {2026-09-07},
	journal = {J. Adv. Model Earth Syst.},
	author = {Leung, L. Ruby and Bader, David C. and Taylor, Mark A. and McCoy, Renata B.},
	month = nov,
	year = {2020},
	pages = {e2019MS001821},
	file = {J Adv Model Earth Syst - 2020 - Leung - An Introduction to the E3SM Special Collection  Goals  Science Drivers  Development:/Users/mahf708/Zotero/storage/M7FIDPQ5/J Adv Model Earth Syst - 2020 - Leung - An Introduction to the E3SM Special Collection  Goals  Science Drivers  Development.pdf:application/pdf},
}

