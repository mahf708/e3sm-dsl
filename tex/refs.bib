	file = {Submitted Version:/Users/mahf708/Zotero/storage/VQQ3A2MM/Duncan et al. - 2024 - Application of the AI2 Climate Emulator to E3SMv2's Global Atmosphere Model, With a Focus on Precipi.pdf:application/pdf},
